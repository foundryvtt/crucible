<section class="tab secondary {{tabs.proficiency.id}} scrollable flexcol {{tabs.proficiency.cssClass}}"
         data-tab="{{tabs.proficiency.id}}" data-group="{{tabs.proficiency.group}}">

    <div class="header-section flexrow">
        <div class="point-pools flexrow">
            <span class="label">{{localize "ACTOR.SHEET.PointsAvailable"}}</span>
            <span class="value">{{proficiency.available}}</span>
            <span class="label">{{localize "ACTOR.SHEET.PointsSpent"}}</span>
            <span class="value">{{proficiency.spent}}</span>
            <a class="button icon fa-solid fa-undo" data-action="proficiencyReset"
               aria-label="{{localize "ACTOR.ACTIONS.ResetProficiency"}}" data-tooltip></a>
        </div>
    </div>

    {{#each proficiency.sections as |section|}}
    <div class="sheet-section item-section flexcol">
        <h3 class="section-header">{{section.label}}</h3>
        <ol class="items-list proficiency-list" style="--bar-color: {{section.color}}"
            data-tooltip-direction="LEFT">
            {{#each section.types as |training|}}
            <li class="line-item training{{#if training.rollable}} skill{{/if}}"
                data-training="{{training.id}}" data-skill="{{training.id}}">
                <img class="icon" src="{{training.icon}}" alt="{{training.label}}">
                <div class="title">
                    {{#if training.rollable}}
                    <h4 aria-label="{{localize "ACTOR.ACTIONS.RollCheck"}}" data-tooltip
                        data-action="skillRoll"><a>{{training.label}}</a></h4>
                    {{else}}
                    <h4>{{training.label}}</h4>
                    {{/if}}
                    <div class="tags">
                        <span class="rank tag">{{training.rank.label}}</span>
                        {{#each training.abilityAbbrs}}<span class="attribute tag">{{this}}</span>{{/each}}
                    </div>
                </div>
                <div class="bonus flexrow">
                    {{#if training.rollable}}
                    <span class="passive"
                          data-tooltip="{{localize "SKILL.PassiveSpecific" passive=training.tooltips.passive}}">
                        {{training.passive}}
                    </span>
                    {{/if}}
                    <span class="value hex small {{training.hexClass}}" data-tooltip="{{training.tooltips.value}}">
                        {{numberFormat training.score sign=true}}
                    </span>
                </div>
                <div class="bar-container" data-tooltip="{{training.tooltips.points}}"
                     data-tooltip-class="crucible">
                    <span class="bar" style="width: {{training.widthPct}}"></span>
                    {{#each ../../proficiency.ticks as |tick|}}
                    <span class="tick" style="left: {{tick.left}}" data-tooltip aria-label="{{tick.label}}"></span>
                    {{/each}}
                    {{#with training.capTick as |cap|}}
                    <span class="tick cap" style="left: {{cap.left}}" data-tooltip aria-label="{{cap.label}}"></span>
                    {{/with}}
                </div>
                <div class="buttons flexcol">
                    <button type="button" class="plain icon fa-solid fa-caret-up" data-action="proficiencyIncrease"
                            data-tooltip aria-label="{{localize 'TRAINING.Increase'}}"
                            {{#unless training.canIncrease}}disabled{{/unless}}></button>
                    <button type="button" class="plain icon fa-solid fa-caret-down" data-action="proficiencyDecrease"
                            data-tooltip aria-label="{{localize 'TRAINING.Decrease'}}"
                            {{#unless training.canDecrease}}disabled{{/unless}}></button>
                </div>
            </li>
            {{/each}}
        </ol>
    </div>
    {{/each}}

    <footer class="tab-footer skills-footer flexrow">
        <div class="sheet-section flexcol">
            <h3>
                {{localize "ACTOR.LABELS.Knowledge"}}
                <a class="control icon fa-solid fa-gear" data-action="editDetailsProperty" data-property="knowledge"></a>
            </h3>
            <div class="tags knowledge-areas">
                {{#each knowledge.known}}
                <span
                    class="larger tag knowledge-area{{#if fromBackground}} background-granted{{/if}}"
                    {{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}
                >
                    {{label}}
                </span>
                {{else}}
                <p class="hint">{{knowledge.hint}}</p>
                {{/each}}
            </div>
        </div>
        <div class="sheet-section flexcol">
            <h3>
                {{localize "ACTOR.LABELS.Languages"}}
                <a class="control icon fa-solid fa-gear" data-action="editDetailsProperty" data-property="languages"></a>
            </h3>
            <div class="tags languages">
                {{#each languages.known}}
                <span
                    class="larger tag language{{#if fromBackground}} background-granted{{/if}}"
                    {{#if tooltip}} data-tooltip="{{tooltip}}"{{/if}}
                >
                    {{label}}
                </span>
                {{else}}
                <p class="hint">{{languages.hint}}</p>
                {{/each}}
            </div>
        </div>
    </footer>
</section>
