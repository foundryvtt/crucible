<div>
    {{!-- Sheet Header --}}
    <header class="sheet-header flexrow">
        <img class="profile" src="{{config.icon}}" title="{{config.name}}"/>
        <div class="header-content flexrow">
            <h1 class="title">{{config.name}}</h1>
            <div class="purchase">
                <button type="button" class="icon fa-solid fa-book-open" data-action="rules"></button>
                <button type="button" class="icon fa-solid fa-minus" data-action="decrease"></button>
                <span class="rank">{{skill.rank}}</span>
                <button type="button" class="icon fa-solid fa-plus" data-action="increase"></button>
            </div>
        </div>
    </header>

    {{!-- Sheet Body --}}
    <section class="sheet-body flexcol scrollable">
        <div class="description skill-description">
            {{{config.overview}}}
        </div>

        {{#if displayPath}}
        <h3>{{localize "SKILL.SpecializationPathSpecific" path=path.name}}</h3>
        <div class="description path-description">
            {{{path.overview}}}
        </div>
        {{/if}}

        {{#if choosePath}}
        <h2 class="divider">{{localize "SKILL.SpecializationPathSelect"}}</h2>
        <div class="skill-ranks current-ranks">
            {{#each config.paths as |path|}}
            <h3>
                <button type="button" class="icon choose-path {{path.actionIcon}}" data-action="choosePath" data-path="{{path.id}}"
                   aria-label="{{localize path.actionTooltip}}" data-tooltip></button>
                {{path.name}}
            </h3>
            {{{path.overview}}}
            {{/each}}
        </div>
        {{/if}}

        <h2 class="divider">{{localize "SKILL.AcquiredRanks"}}</h2>
        <div class="skill-ranks current-ranks">
            {{#each trainedRanks}}
            <h3>{{this.label}}</h3>
            {{{this.description}}}
            {{/each}}
        </div>

        {{#if untrainedRanks.length}}
        <h2 class="divider">{{localize "SKILL.UnacquiredRanks"}}</h2>
        <div class="skill-ranks current-ranks">
            {{#each untrainedRanks}}
            <h3>{{this.label}}</h3>
            {{{this.description}}}
            {{/each}}
        </div>
        {{/if}}

        {{#if showPaths}}
        <h2 class="divider">{{localize "SKILL.SpecializationPaths"}}</h2>
        <div class="skill-ranks skill-paths">
            {{#each config.paths as |path|}}
            <h3>{{path.name}}</h3>
            {{{path.overview}}}
            {{/each}}
        </div>
        {{/if}}
    </section>
</div>
