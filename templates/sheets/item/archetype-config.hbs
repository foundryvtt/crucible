<section class="tab sheet-body standard-form scrollable {{tabs.config.cssClass}}"
         data-tab="{{tabs.config.id}}" data-group="{{tabs.config.group}}">

    <fieldset {{fieldDisabled}}>
        <legend>{{localize "BACKGROUND.SHEET.Identity"}}</legend>
        {{formGroup fields.identifier value=system.identifier}}
    </fieldset>

    <fieldset class="form-group abilities" {{fieldDisabled}}>
        <legend>{{fields.abilities.label}} <span class="sum"></span></legend>
        <div class="form-fields">
            {{#each abilities as |a|}}
            <label>
                {{formInput a.field value=a.value type="number"}}
                {{a.label}}
            </label>
            {{/each}}
        </div>
        <p class="hint">{{fields.abilities.hint}}</p>
    </fieldset>
    <fieldset class="training" {{fieldDisabled}}>
        <legend>{{localize "ARCHETYPE.SHEET.Training"}}</legend>
        {{#if training.rows.length}}
        <div class="form-fields">
            {{#each training.rows as |p|}}
            <div class="training-weight {{#if p.spare}}spare{{/if}}" data-proficiency="{{p.id}}"
                 {{#if p.spare}}data-tooltip="ARCHETYPE.SHEET.TrainingSpare"{{/if}}>
                {{formInput p.field value=p.value type="number" name=p.name}}
                <span class="proficiency">{{p.label}}</span>
                <a class="remove" data-action="trainingRemove" data-tooltip="ARCHETYPE.SHEET.TrainingRemove">
                    <i class="fa-solid fa-times"></i>
                </a>
            </div>
            {{/each}}
        </div>
        {{/if}}
        {{#if training.options.length}}
        {{formInput training.field name="trainingAdd" value="" options=training.options groups=training.groups
                    blank=(localize "ARCHETYPE.SHEET.TrainingAdd")}}
        {{/if}}
        <p class="hint">{{localize "ARCHETYPE.SHEET.TrainingHint"}}</p>
    </fieldset>
</section>
