<section class="tab sheet-body flexcol scrollable {{tabs.actions.cssClass}}"
         data-tab="{{tabs.actions.id}}" data-group="{{tabs.actions.group}}">
    {{#each actionGroups}}
    <fieldset>
        <legend>
            <span>{{#if this.legend}}{{this.legend}}{{else}}{{localize "ITEM.TABS.actions"}}{{/if}}</span>
            {{#if this.canAdd}}
            <button type="button" class="icon fa-solid fa-plus" data-action="actionAdd"
                    aria-label="{{localize "TALENT.ACTIONS.ActionAdd"}}" data-tooltip></button>
            {{/if}}
        </legend>
        {{#each this.actions as |action|}}
        {{> (lookup @root "actionPartial") action=action isEditable=../isEditable}}
        {{/each}}
    </fieldset>
    {{/each}}
</section>
