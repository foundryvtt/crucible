<section class="tab sheet-body standard-form scrollable {{tabs.config.cssClass}}"
         data-tab="{{tabs.config.id}}" data-group="{{tabs.config.group}}">

    <fieldset {{fieldDisabled}}>
        <legend>{{localize "BACKGROUND.SHEET.Identity"}}</legend>
        {{formGroup fields.identifier value=system.identifier}}
        {{formGroup fields.ui.fields.color value=system.ui.color}}
    </fieldset>

    <fieldset {{fieldDisabled}}>
        <legend>{{localize "BACKGROUND.SHEET.Grants"}}</legend>
        {{#each grants as |grant|}}
        <div class="form-group">
            <label>
                {{grant.field.label}}
                <span class="sum {{#if grant.warning}}invalid{{/if}}"
                      {{#if grant.warning}}data-tooltip="{{grant.warning}}"{{/if}}>
                    {{grant.count}} / {{grant.expected}}
                </span>
            </label>
            <div class="form-fields">
                {{formInput grant.field value=grant.value options=grant.options sort=grant.sort}}
            </div>
        </div>
        {{/each}}
    </fieldset>
</section>
