<div class="crucible-item-card line-item talent" data-uuid="{{uuid}}">
    <header class="flexrow">
        <div class="icon-frame">
            <img class="icon" src="{{source.img}}" alt="{{source.name}}">
        </div>
        <div class="title">
            <h2 data-no-toc>{{source.name}}</h2>
            <div class="talent-tags tags prerequisites">
                {{~#if origin}}<span class="tag">{{origin}}</span>{{/if~}}
                {{~#each prerequisites as |req|}}
                <span class="tag {{#unless req.met}}unmet{{/unless}}">{{req.tag}}</span>
                {{/each~}}
                {{~#if training}}<span class="tag training">{{training}}</span>{{/if~}}
            </div>
        </div>
    </header>
    {{> "systems/crucible/templates/sheets/item/talent-summary.hbs"}}
</div>
