<section class="tab sheet-body flexcol {{description.tab.cssClass}}"
         data-tab="{{description.tab.id}}" data-group="{{description.tab.group}}">

    {{#if hasAdvancedDescription}}
    <div class="sheet-section flexcol expandable {{description.publicClass}}">
        <h3 data-action="expandSection" data-tooltip="{{description.publicField.hint}}">
            {{description.publicField.label}}
            <i class="fa-solid fa-chevron-right" inert></i>
        </h3>
        {{formInput description.publicField value=description.publicSrc enriched=description.publicHTML toggled=true}}
    </div>
    {{#if description.privateField}}
    <div class="sheet-section flexcol expandable {{description.privateClass}}">
        <h3 data-action="expandSection" data-tooltip="{{description.privateField.hint}}">
            {{description.privateField.label}}
            <i class="fa-solid fa-chevron-right" inert></i>
        </h3>
        {{formInput description.privateField value=description.privateSrc enriched=description.privateHTML toggled=true}}
    </div>
    {{/if}}
    {{else}}
    {{#if isEditable}}
    {{formInput description.field value=description.publicSrc enriched=description.publicHTML toggled=true}}
    {{else}}
    <article class="editor-content scrollable">{{{description.publicHTML}}}</article>
    {{/if}}
    {{/if}}
</section>
