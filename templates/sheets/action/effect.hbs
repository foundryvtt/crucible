<fieldset class="effect" data-index="{{effect.index}}">
    <div class="form-group">
        <label>{{fields.name.label}}</label>
        <div class="form-fields">
            {{formInput fields.name name=(concat effect.fieldPath ".name") placeholder=placeholder value=effect.name}}
            <button type="button" class="icon frame-brown fa-solid fa-trash"
                    data-action="deleteEffect" aria-label="{{localize "ACTION.EFFECTS.Delete"}}" data-tooltip></button>
        </div>
    </div>
    {{formGroup fields.scope name=(concat effect.fieldPath ".scope") value=effect.scope localize=true}}
    <div class="form-group">
        <label>{{fields.result.label}}</label>
        <div class="form-fields">
            {{formInput fields.result.fields.type name=(concat effect.fieldPath ".result.type") value=effect.result.type}}
            <label class="checkbox">
                {{fields.result.fields.all.label}}
                {{formInput fields.result.fields.all name=(concat effect.fieldPath ".result.all") value=effect.result.all}}
            </label>
        </div>
    </div>
    {{formGroup fields.statuses name=(concat effect.fieldPath ".statuses") value=effect.statuses valueAttr="id" labelAttr="name" localize=true}}
    <div class="form-group slim">
        <label>{{fields.duration.label}}</label>
        <div class="form-fields">
            {{formInput fields.duration.fields.value name=(concat effect.fieldPath ".duration.value")
                        value=effect.duration.value}}
            {{formInput fields.duration.fields.units name=(concat effect.fieldPath ".duration.units")
                        value=effect.duration.units options=effectDurations}}
        </div>
    </div>
    {{formGroup fields.duration.fields.expiry name=(concat effect.fieldPath ".duration.expiry")
                value=effect.duration.expiry options=effectExpiryEvents}}
    <div class="form-group slim">
        <label>{{localize removableField.label}}</label>
        <div class="form-fields">
            {{formInput removableField name=(concat effect.fieldPath ".removable") value=effect.removable}}
            {{#if effect.removable}}
            {{formInput fields.system.fields.dc name=(concat effect.fieldPath ".system.dc") value=effect.system.dc
                        placeholder=(localize "DICE.DC")}}
            {{/if}}
        </div>
        <p class="hint">{{localize "ACTION.EFFECTS.RemovableHint"}}</p>
    </div>
</fieldset>
